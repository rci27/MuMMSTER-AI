# sbdb-frontend (Gatsby) build-time configuration

# Datasette JSON API used by gatsby-node.js to fetch all tables at build time.
# In production this points at LXC 124 on the private LAN.
DATASETTE_URL=http://192.168.1.72:8001

# Public AI query API used by the in-page Ask panel at runtime.
GATSBY_QUERY_API_URL=https://sbdb-ai-query.theronlab.com
