# mummster-curation configuration

# Anthropic API key — preferred: file at this path, fallback: ANTHROPIC_API_KEY env var
# (the code reads the file first; if it does not exist, falls back to the env var)
ANTHROPIC_API_KEY=

# LXC 124 (pipeline container) connectivity for SSH/SCP
LXC124_IP=192.168.1.72
LXC124_USER=root
LXC124_DB=/opt/mummster/data/mummster.db
LXC124_PDF_DIR=/opt/mummster/data/pdfs
