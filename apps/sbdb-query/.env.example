# sbdb-query configuration (public API clone of mummster-query)

# Path to a file containing the Anthropic API key
ANTHROPIC_KEY_PATH=/etc/artemis-secrets/anthropic.key

# DuckDB database (read-only mount in production)
DUCKDB_PATH=/opt/mummster/data/mummster.db

# Generated schema/context summary (markdown, regenerated from data)
DATA_CONTEXT_PATH=/opt/mummster/data/data_context.md

# Log directory
LOG_DIR=/mnt/artemis-data/logs/sbdb-query
