# mummster-pipeline configuration
#
# The pipeline reads its config from a key=value file. The path to that file
# is controlled by MUMMSTER_CONFIG (default: /opt/mummster/config.env).
# Environment variables override file values for the same key.
#
# Either set MUMMSTER_CONFIG to point at a config.env containing the keys
# below, or export them directly as environment variables.

# --- Required ---
MUMMSTER_CONFIG=/opt/mummster/config.env

SHEET_ID=your_google_sheet_id_here
DB_PATH=/opt/mummster/data/mummster.db
PDF_DIR=/opt/mummster/data/pdfs

# Google Sheet tab GIDs (numeric IDs of individual sheet tabs)
GID_MAIN_RESULTS=0
GID_CUSTARDS_LAST_STAND=0
GID_VIEWERS_CHOICE=0
GID_LIFETIME_ACHIEVEMENT=0
GID_HALL_OF_FAME=0
GID_PARADE_INFO=0

# --- Optional ---
BACKUP_DIR=/opt/mummster/data/backups
SQLITE_PATH=/opt/mummster/data/datasette.db
PDF_LINK_COLUMN=
PDF_COUNT_EXPECTED=0
FORCE_VISION=false

# Vision extraction (Anthropic API)
ANTHROPIC_KEY_PATH=/etc/artemis-secrets/anthropic.key
VISION_COST_LIMIT=10.0
